#!/bin/sh

set -e

# ----------------------------------------------------------------------------
# arguments
# ----------------------------------------------------------------------------

arg_user='timesheet'
arg_home='/var/lib/timesheet'
arg_config='/etc/timesheet/timesheet.json'
arg_template='/usr/share/timesheet/database-template.json'
arg_database=''
arg_create_user='not-set'
arg_create_home='not-set'
arg_create_database='not-set'

# ----------------------------------------------------------------------------
# parse arguments
# ----------------------------------------------------------------------------

case "${1}" in
    configure)
        arg_create_user='yes'
        arg_create_home='yes'
        arg_create_database='yes'
        ;;
    abort-upgrade)
        ;;
    abort-remove)
        ;;
    abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

# ----------------------------------------------------------------------------
# create the system account
# ----------------------------------------------------------------------------

if [ "${arg_create_user}" = 'yes' ] && ! getent passwd "${arg_user}" > /dev/null
then
    adduser --system --group --quiet --home "${arg_home}" --no-create-home "${arg_user}"
fi

# ----------------------------------------------------------------------------
# create the directory of the database
# ----------------------------------------------------------------------------

if [ "${arg_create_home}" = 'yes' ] && [ ! -d "${arg_home}" ]
then
    install -d -o "${arg_user}" -g "${arg_user}" -m 0700 "${arg_home}"
fi

# ----------------------------------------------------------------------------
# create the database
# ----------------------------------------------------------------------------

if [ "${arg_create_database}" = 'yes' ]
then
    arg_database="$(/usr/bin/timesheet config show database.path --config="${arg_config}")" || arg_database=''
fi

if [ "${arg_create_database}" = 'yes' ] && [ -z "${arg_database}" ]
then
    echo "timesheet: ${arg_config} cannot be read, no database created (see the migration notes of the specifications)" >&2
elif [ "${arg_create_database}" = 'yes' ] && [ "${arg_database}" = 'null' ]
then
    echo "timesheet: ${arg_config} names no database (database.path), no database created" >&2
elif [ "${arg_create_database}" = 'yes' ] && [ ! -e "${arg_database}" ]
then
    case "${arg_database}" in
        "${arg_home}"/*)
            runuser -u "${arg_user}" -- /usr/bin/timesheet init --config="${arg_config}" --template="${arg_template}"
            ;;
        *)
            echo "timesheet: ${arg_database} is outside ${arg_home}, create it with timesheet init" >&2
            ;;
    esac
fi

# ----------------------------------------------------------------------------
# debian helper
# ----------------------------------------------------------------------------

#DEBHELPER#

exit 0

# ----------------------------------------------------------------------------
# End-Of-File
# ----------------------------------------------------------------------------
